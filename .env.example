# Application Configuration
APP_NAME="Document AI Assistant"
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# Embedding & Vector Store Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=data/chroma_db
COLLECTION_NAME=document_rag_collection

# RAG & Chunking Parameters
# CHUNK_SIZE and CHUNK_OVERLAP are character approximations (avg 4 chars/token: 500 tokens ~ 2000 chars, 75 tokens ~ 300 chars)
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=3

# Upload Constraints
MAX_UPLOAD_MB=15
UPLOADS_DIR=data/uploads
